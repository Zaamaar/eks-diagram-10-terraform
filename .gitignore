# Terraform local state — contains resource IDs and can contain secrets in plain text.
# Never commit this. Use a remote backend (S3 + DynamoDB) for shared/team state instead.
*.tfstate
*.tfstate.*

# Local .terraform directory — downloaded providers and modules, regenerated by `terraform init`
.terraform/
.terraform.lock.hcl

# Variable files that might hold real values/secrets you don't want in git
*.tfvars
*.tfvars.json

# Crash log files
crash.log
crash.*.log

# OS/editor cruft
.DS_Store
.vscode/
